; x = 8 + 9x + 4x^2 + x^3  ==>  x^7 = 64x
; Known semiring identity; deliberately difficult for naive saturation.

(datatype Expr
  (Zero)
  (One)
  (X)
  (Add Expr Expr)
  (Mul Expr Expr))

(rewrite (Add (Zero) y) y)
(birewrite (Add x y) (Add y x))
(birewrite (Add x (Add y z)) (Add (Add x y) z))
(rewrite (Mul x (One)) x)
(rewrite (Mul x (Zero)) (Zero))
(birewrite (Mul x y) (Mul y x))
(birewrite (Mul x (Mul y z)) (Mul (Mul x y) z))
(birewrite (Mul x (Add y z))
           (Add (Mul x y) (Mul x z)))

(let $two (Add (One) (One)))
(let $four (Add $two $two))
(let $eight (Add $four $four))
(let $nine (Add $eight (One)))
(let $sixtyfour (Mul $eight $eight))
(let $x2 (Mul (X) (X)))
(let $x3 (Mul (X) $x2))
(let $x7 (Mul (X) (Mul (X) (Mul (X) (Mul (X) (Mul (X) (Mul (X) (X))))))))

(union (X) (Add $eight (Add (Mul $nine (X)) (Add (Mul $four $x2) $x3))))
(run 30 :until (= $x7 (Mul $sixtyfour (X))))
(check (= $x7 (Mul $sixtyfour (X))))
