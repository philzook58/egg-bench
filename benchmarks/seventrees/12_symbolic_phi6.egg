; c*x = c^2 + x^2  ==>  c*x^7 = c^7*x
; Here C is a genuine second generator, not a numeral.

(datatype Expr
  (Zero)
  (One)
  (C)
  (X)
  (Add Expr Expr)
  (Mul Expr Expr))

(rewrite (Add (Zero) y) y)
(birewrite (Add x y) (Add y x))
(birewrite (Add x (Add y z)) (Add (Add x y) z))
(rewrite (Mul x (One)) x)
(rewrite (Mul x (Zero)) (Zero))
(birewrite (Mul x y) (Mul y x))
(birewrite (Mul x (Mul y z)) (Mul (Mul x y) z))
(birewrite (Mul x (Add y z))
           (Add (Mul x y) (Mul x z)))

(let $c2 (Mul (C) (C)))
(let $c7 (Mul (C) (Mul (C) (Mul (C) (Mul (C) (Mul (C) (Mul (C) (C))))))))
(let $x2 (Mul (X) (X)))
(let $x7 (Mul (X) (Mul (X) (Mul (X) (Mul (X) (Mul (X) (Mul (X) (X))))))))

(union (Mul (C) (X)) (Add $c2 $x2))
(run 30 :until (= (Mul (C) $x7) (Mul $c7 (X))))
(check (= (Mul (C) $x7) (Mul $c7 (X))))
