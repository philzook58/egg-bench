; x = 8 + 5x + 2x^2 + x^3  ==>  x^5 = 16x

(datatype Expr
  (Zero)
  (One)
  (X)
  (Add Expr Expr)
  (Mul Expr Expr))

(rewrite (Add (Zero) y) y)
(birewrite (Add x y) (Add y x))
(birewrite (Add x (Add y z)) (Add (Add x y) z))
(rewrite (Mul x (One)) x)
(rewrite (Mul x (Zero)) (Zero))
(birewrite (Mul x y) (Mul y x))
(birewrite (Mul x (Mul y z)) (Mul (Mul x y) z))
(birewrite (Mul x (Add y z))
           (Add (Mul x y) (Mul x z)))

(let $two (Add (One) (One)))
(let $four (Add $two $two))
(let $five (Add $four (One)))
(let $eight (Add $four $four))
(let $sixteen (Mul $four $four))
(let $x2 (Mul (X) (X)))
(let $x3 (Mul (X) $x2))
(let $x5 (Mul (X) (Mul (X) (Mul (X) (Mul (X) (X))))))

(union (X) (Add $eight (Add (Mul $five (X)) (Add (Mul $two $x2) $x3))))
(run 30 :until (= $x5 (Mul $sixteen (X))))
(check (= $x5 (Mul $sixteen (X))))
